# Install only on the isolated recovery host, owner postgres, mode 0400. This
# credential is write-only for the exact last-pitr-success status three-object
# prefix (status, .sha256 and .sig); it must not read PITR backup artifacts.
PITR_STATUS_SOURCE_FILE=/var/lib/wangzhe-pitr-drill/work/last-success.status
PITR_STATUS_SIGNATURE_FILE=/var/lib/wangzhe-pitr-drill/work/last-success.status.sig
PITR_STATUS_CLUSTER_ID=CHANGE_ME_POSTGRES_SYSTEM_IDENTIFIER
PITR_STATUS_REMOTE_DESTINATION=CHANGE_ME_RCLONE_REMOTE:wangzhe-production/restore-status/last-pitr-success.status
PITR_STATUS_RCLONE_CONFIG=/etc/wangzhe/pitr-status-write-rclone.conf
PITR_STATUS_MAX_AGE_SECONDS=3600
PITR_STATUS_EXPECTED_BACKUP_REMOTE_SOURCE=CHANGE_ME_RCLONE_REMOTE:wangzhe-production/pitr/CHANGE_ME_POSTGRES_SYSTEM_IDENTIFIER
