# Install as /etc/wangzhe/pitr.env, owner postgres, mode 0400.  The role needs
# LOGIN REPLICATION only; it must not be the application or logical-backup role.
PITR_DATABASE_HOST=127.0.0.1
PITR_DATABASE_PORT=5432
PITR_DATABASE_USER=wangzhe_replication
PITR_DATABASE_PASSWORD=CHANGE_ME_INDEPENDENT_REPLICATION_PASSWORD
PITR_DATABASE_SSLMODE=disable
# Use: sudo -u postgres pg_controldata "$PGDATA" | awk -F: '/Database system identifier/ {gsub(/ /,"",$2); print $2}'
PITR_CLUSTER_ID=CHANGE_ME_POSTGRES_SYSTEM_IDENTIFIER
# Root-owned, non-writable single-line copy of the same identifier.  Archive
# and base-backup jobs refuse to label artifacts when this trust anchor differs.
PITR_CLUSTER_ID_FILE=/etc/wangzhe/pitr-cluster-id
PITR_AGE_RECIPIENT=age1CHANGE_ME_PUBLIC_RECIPIENT
PITR_REQUIRE_OFFSITE=1
PITR_REMOTE_DESTINATION=CHANGE_ME_RCLONE_REMOTE:wangzhe-production/pitr/CHANGE_ME_POSTGRES_SYSTEM_IDENTIFIER
PITR_RCLONE_CONFIG=/etc/wangzhe/pitr-rclone.conf
# Separate Ed25519 PKCS#8 key used only to authenticate base/WAL artifacts.
PITR_PROVENANCE_SIGNING_KEY_FILE=/etc/wangzhe/pitr-provenance-ed25519-private.pem
PITR_WAL_ARCHIVE_DIR=/var/backups/wangzhe/wal/CHANGE_ME_POSTGRES_SYSTEM_IDENTIFIER
PITR_BASEBACKUP_DIR=/var/backups/wangzhe/base/CHANGE_ME_POSTGRES_SYSTEM_IDENTIFIER
PITR_BASEBACKUP_RETENTION_DAYS=35
PITR_PLAINTEXT_WORK_DIR=/var/lib/wangzhe-backup-work/pitr
PITR_LOCK_WAIT_SECONDS=60
