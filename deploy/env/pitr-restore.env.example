# Keep this file and the AGE identity on an isolated recovery host, not on the
# production application host. Install owner postgres, mode 0400. The rclone
# credential is read-only and restricted to this exact PITR cluster prefix; it
# must not be able to write restore-status objects.
PITR_RESTORE_AGE_IDENTITY_FILE=/etc/wangzhe/pitr-recovery-age-identity.txt
PITR_RESTORE_PROVENANCE_VERIFY_KEY_FILE=/etc/wangzhe/pitr-provenance-ed25519-public.pem
PITR_RESTORE_CLUSTER_ID=CHANGE_ME_POSTGRES_SYSTEM_IDENTIFIER
PITR_RESTORE_LOCAL_ARCHIVE_DIR=/var/backups/wangzhe/wal/CHANGE_ME_POSTGRES_SYSTEM_IDENTIFIER
PITR_RESTORE_REMOTE_DESTINATION=CHANGE_ME_RCLONE_REMOTE:wangzhe-production/pitr/CHANGE_ME_POSTGRES_SYSTEM_IDENTIFIER
PITR_RESTORE_RCLONE_CONFIG=/etc/wangzhe/pitr-wal-read-rclone.conf
