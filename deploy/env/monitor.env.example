# Install as /etc/wangzhe/monitor.env, owner wangzhe-monitor, mode 0400.
# Use a database role with CONNECT, pg_monitor and SELECT only on lottery_bets,
# user, user_balance_transactions and user_balance_transaction_archives.
# Install MONITOR_RCLONE_CONFIG separately as wangzhe-monitor mode 0400. Its
# credential must have read/list access only to database, uploads, current
# cluster basebackup/WAL, and restore-status prefixes; deny writes and deletes.
MONITOR_BACKEND_URL=http://127.0.0.1:8080
MONITOR_DATABASE_HOST=127.0.0.1
MONITOR_DATABASE_PORT=5432
MONITOR_DATABASE_USER=wangzhe_monitor
MONITOR_DATABASE_PASSWORD=CHANGE_ME_INDEPENDENT_MONITOR_PASSWORD
MONITOR_DATABASE_DBNAME=wangzhe
MONITOR_DATABASE_SSLMODE=disable
MONITOR_REDIS_ENV_FILE=/etc/wangzhe/redis-check.env
MONITOR_DATABASE_BACKUP_DIR=/var/backups/wangzhe/database
MONITOR_UPLOAD_BACKUP_DIR=/var/backups/wangzhe/uploads
MONITOR_PITR_WAL_DIR=/var/backups/wangzhe/wal/CHANGE_ME_POSTGRES_SYSTEM_IDENTIFIER
MONITOR_PITR_BASEBACKUP_DIR=/var/backups/wangzhe/base/CHANGE_ME_POSTGRES_SYSTEM_IDENTIFIER
MONITOR_RESTORE_STATUS_FILE=/var/lib/wangzhe-monitor/last-restore-drill.status
MONITOR_RESTORE_STATUS_REMOTE_SOURCE=CHANGE_ME_RCLONE_REMOTE:wangzhe-production/restore-status/last-success.status
MONITOR_RESTORE_STATUS_VERIFY_KEY_FILE=/etc/wangzhe/logical-restore-status-ed25519-public.pem
# Bind signed restore evidence to the exact production source. A validly signed
# drill against another database/prefix must not satisfy production monitoring.
MONITOR_RESTORE_EXPECTED_DATABASE_NAME=wangzhe
MONITOR_RESTORE_EXPECTED_DATABASE_REMOTE_SOURCE=CHANGE_ME_RCLONE_REMOTE:wangzhe-production
MONITOR_RESTORE_EXPECTED_UPLOAD_REMOTE_SOURCE=CHANGE_ME_RCLONE_REMOTE:wangzhe-production
MONITOR_PITR_RESTORE_STATUS_FILE=/var/lib/wangzhe-monitor/last-pitr-drill.status
MONITOR_PITR_RESTORE_STATUS_REMOTE_SOURCE=CHANGE_ME_RCLONE_REMOTE:wangzhe-production/restore-status/last-pitr-success.status
MONITOR_PITR_RESTORE_STATUS_VERIFY_KEY_FILE=/etc/wangzhe/pitr-restore-status-ed25519-public.pem
MONITOR_RCLONE_CONFIG=/etc/wangzhe/monitor-rclone.conf
MONITOR_BACKUP_PROVENANCE_VERIFY_KEY_FILE=/etc/wangzhe/backup-provenance-ed25519-public.pem
MONITOR_PITR_PROVENANCE_VERIFY_KEY_FILE=/etc/wangzhe/pitr-provenance-ed25519-public.pem
# Exact PITR artifact prefix attested by the isolated recovery host.
MONITOR_PITR_RESTORE_EXPECTED_REMOTE_SOURCE=CHANGE_ME_RCLONE_REMOTE:wangzhe-production/pitr/CHANGE_ME_POSTGRES_SYSTEM_IDENTIFIER
MONITOR_TLS_HOSTS=wz6688.app,admin.wz6688.app
MONITOR_TLS_PORT=443
MONITOR_NGINX_ACCESS_LOG=/var/log/nginx/wangzhe-access.log
MONITOR_STATE_DIR=/var/lib/wangzhe-monitor
MONITOR_BACKUP_INTEGRITY_STATUS_FILE=/var/lib/wangzhe-monitor/last-backup-integrity.status
MONITOR_MAX_BACKUP_AGE_MINUTES=1560
MONITOR_MAX_WAL_ARCHIVE_AGE_MINUTES=15
MONITOR_MAX_BASEBACKUP_AGE_MINUTES=11520
MONITOR_MAX_RESTORE_DRILL_AGE_MINUTES=50400
MONITOR_MAX_PITR_RESTORE_DRILL_AGE_MINUTES=50400
# Daily timer plus randomized delay: alert if no successful full local/remote
# checksum run has completed within 30 hours.
MONITOR_MAX_BACKUP_INTEGRITY_AGE_MINUTES=1800
MONITOR_MAX_5XX_PER_INTERVAL=0
MONITOR_MAX_DATABASE_CONNECTION_PERCENT=80
MONITOR_MAX_BACKUP_DISK_PERCENT=80
MONITOR_MAX_BACKUP_INODE_PERCENT=80
# Arithmetic/orphan/reference/chain scans run at this lower frequency. Their
# last successful counts remain in every minute-level alert until refreshed.
MONITOR_ACCOUNTING_AUDIT_INTERVAL_MINUTES=60
# Re-send an unchanged firing alert so a long incident cannot be silently
# forgotten after the first Webhook delivery. Changes and recovery notify now.
MONITOR_ALERT_REPEAT_MINUTES=60
MONITOR_WEBHOOK_URL=https://CHANGE_ME_ALERT_RECEIVER.example/v1/alerts
MONITOR_WEBHOOK_BEARER_TOKEN=CHANGE_ME_RANDOM_ALERT_TOKEN
