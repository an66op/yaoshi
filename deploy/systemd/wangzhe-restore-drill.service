[Unit]
Description=Isolated Wangzhe database and upload restore drill
After=local-fs.target network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/wangzhe-restore
OnFailure=wangzhe-ops-failure-alert@%n.service

[Service]
Type=oneshot
User=wangzhe-restore
Group=wangzhe-restore
ExecStart=/opt/wangzhe/current/scripts/production-restore-drill.sh /etc/wangzhe/restore-drill.env
TimeoutStartSec=12h
UMask=0077
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/wangzhe/restore-drill.env /etc/wangzhe/logical-recovery-age-identity.txt /etc/wangzhe/backup-provenance-ed25519-public.pem /etc/wangzhe/logical-restore-source-read-rclone.conf /etc/wangzhe/logical-restore-status-write-rclone.conf /etc/wangzhe/logical-restore-status-ed25519-private.pem /etc/wangzhe/recovery-host
ReadWritePaths=/var/lib/wangzhe-restore/work
NoNewPrivileges=true
PrivateDevices=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
SystemCallArchitectures=native
