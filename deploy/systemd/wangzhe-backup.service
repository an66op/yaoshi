[Unit]
Description=Verified PostgreSQL backup for Wangzhe
After=postgresql.service

[Service]
Type=oneshot
User=root
Group=root
Environment=BACKUP_DIR=/var/backups/wangzhe
Environment=BACKUP_RETENTION_DAYS=14
ExecStart=/opt/wangzhe/scripts/postgres-backup.sh /etc/wangzhe/backend.env
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/wangzhe
NoNewPrivileges=true
