# Install as /etc/wangzhe/redis-check.env, owner wangzhe-monitor, mode 0400.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=wangzhe-monitor
REDIS_PASSWORD=CHANGE_ME_INDEPENDENT_MONITOR_REDIS_PASSWORD
# Only the public ACL identity and namespace are needed for drift auditing.
# Never put the application Redis password in this monitor-owned file.
REDIS_EXPECTED_APP_USERNAME=wangzhe-app
REDIS_EXPECTED_APP_PREFIX=wangzhe-production
REDIS_TLS=false
REDIS_CA_FILE=
