# Install as /etc/wangzhe/recovery-evidence.env, root:root 0400.
# The dedicated rclone credential at
# /etc/wangzhe/recovery-evidence-read-rclone.conf may read only the two exact
# status triples below (status, .sha256 and .sig); it must not write/delete or
# read backup payloads. CHANGE_ME values make the release gate fail closed.
RECOVERY_EVIDENCE_LOGICAL_STATUS_REMOTE_SOURCE=CHANGE_ME_RCLONE_REMOTE:wangzhe-production/restore-status/last-success.status
RECOVERY_EVIDENCE_PITR_STATUS_REMOTE_SOURCE=CHANGE_ME_RCLONE_REMOTE:wangzhe-production/restore-status/last-pitr-success.status
RECOVERY_EVIDENCE_EXPECTED_DATABASE_NAME=wangzhe
RECOVERY_EVIDENCE_EXPECTED_DATABASE_REMOTE_SOURCE=CHANGE_ME_RCLONE_REMOTE:wangzhe-production
RECOVERY_EVIDENCE_EXPECTED_UPLOAD_REMOTE_SOURCE=CHANGE_ME_RCLONE_REMOTE:wangzhe-production
RECOVERY_EVIDENCE_EXPECTED_PITR_REMOTE_SOURCE=CHANGE_ME_RCLONE_REMOTE:wangzhe-production/pitr/CHANGE_ME_POSTGRES_SYSTEM_IDENTIFIER
RECOVERY_EVIDENCE_PITR_CLUSTER_ID=CHANGE_ME_POSTGRES_SYSTEM_IDENTIFIER
# Both release proofs must be newer than 35 days; 30 days leaves timer margin.
RECOVERY_EVIDENCE_LOGICAL_MAX_AGE_SECONDS=2592000
RECOVERY_EVIDENCE_PITR_MAX_AGE_SECONDS=2592000
# A fresh PITR proof cannot bless a stale backup/WAL source snapshot.
RECOVERY_EVIDENCE_PITR_MAX_SOURCE_AGE_SECONDS=172800
