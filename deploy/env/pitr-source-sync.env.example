# Install only on the isolated recovery host, owner postgres, mode 0400.
# The rclone credential must be read-only and restricted to this exact cluster
# prefix; it must not be the production archive writer or status publisher.
PITR_SOURCE_SYNC_ROOT=/var/lib/wangzhe-pitr-source
PITR_SOURCE_SYNC_CLUSTER_ID=CHANGE_ME_POSTGRES_SYSTEM_IDENTIFIER
PITR_SOURCE_SYNC_REMOTE_DESTINATION=CHANGE_ME_RCLONE_REMOTE:wangzhe-production/pitr/CHANGE_ME_POSTGRES_SYSTEM_IDENTIFIER
PITR_SOURCE_SYNC_RCLONE_CONFIG=/etc/wangzhe/pitr-wal-read-rclone.conf
PITR_SOURCE_SYNC_PROVENANCE_VERIFY_KEY_FILE=/etc/wangzhe/pitr-provenance-ed25519-public.pem
