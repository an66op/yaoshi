# Install as /etc/wangzhe/backup-crypto.env, owner wangzhe-backup, mode 0400.
# Keep the AGE secret identity only on the isolated recovery host.  The
# production host needs only this public recipient.
BACKUP_AGE_RECIPIENT=age1CHANGE_ME_PUBLIC_RECIPIENT
BACKUP_REQUIRE_OFFSITE=1
BACKUP_REMOTE_DESTINATION=CHANGE_ME_RCLONE_REMOTE:wangzhe-production
BACKUP_RCLONE_CONFIG=/etc/wangzhe/backup-rclone.conf
# Independent Ed25519 PKCS#8 key used only to authenticate DB/uploads artifacts.
BACKUP_PROVENANCE_SIGNING_KEY_FILE=/etc/wangzhe/backup-provenance-ed25519-private.pem
BACKUP_DIR=/var/backups/wangzhe/database
BACKUP_RETENTION_DAYS=14
BACKUP_PLAINTEXT_WORK_DIR=/var/lib/wangzhe-backup-work/database
BACKUP_UPLOAD_SOURCE_DIR=/var/lib/wangzhe/uploads
BACKUP_UPLOAD_DIR=/var/backups/wangzhe/uploads
BACKUP_UPLOAD_RETENTION_DAYS=14
BACKUP_UPLOAD_PLAINTEXT_WORK_DIR=/var/lib/wangzhe-backup-work/uploads
BACKUP_LOCK_WAIT_SECONDS=60
