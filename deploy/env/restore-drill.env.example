# Install only on an isolated recovery host, owner wangzhe-restore, mode 0400.
# Never install the AGE identity or this file on the production application host.
RESTORE_DRILL_ISOLATION_MARKER=/etc/wangzhe/recovery-host
RESTORE_DRILL_DATABASE_HOST=127.0.0.1
RESTORE_DRILL_DATABASE_PORT=5432
RESTORE_DRILL_DATABASE_USER=wangzhe_restore
RESTORE_DRILL_DATABASE_PASSWORD=CHANGE_ME_RECOVERY_ONLY_PASSWORD
RESTORE_DRILL_DATABASE_SSLMODE=disable
RESTORE_DRILL_MAINTENANCE_DATABASE=postgres
RESTORE_DRILL_TARGET_DATABASE=wangzhe_restore_drill
RESTORE_DRILL_AGE_IDENTITY_FILE=/etc/wangzhe/logical-recovery-age-identity.txt
RESTORE_DRILL_BACKUP_PROVENANCE_VERIFY_KEY_FILE=/etc/wangzhe/backup-provenance-ed25519-public.pem
RESTORE_DRILL_SOURCE_DATABASE_NAME=wangzhe
# The current backup writer stores both artifact classes in one remote prefix,
# but the two exact sources remain separate settings for strict filename filters
# and can later point at separately isolated prefixes.
RESTORE_DRILL_DATABASE_REMOTE_SOURCE=CHANGE_ME_RCLONE_REMOTE:wangzhe-production
RESTORE_DRILL_UPLOAD_REMOTE_SOURCE=CHANGE_ME_RCLONE_REMOTE:wangzhe-production
# Owner wangzhe-restore, mode 0400.  This credential may only list/read the two
# source prefixes; it must not write or delete remote objects.
RESTORE_DRILL_SOURCE_RCLONE_CONFIG=/etc/wangzhe/logical-restore-source-read-rclone.conf
# /var/lib/wangzhe-restore itself is a root-owned, direct LUKS dm-crypt mount;
# only its pre-created owner-only work child is writable by wangzhe-restore.
RESTORE_DRILL_UPLOAD_TARGET_DIR=/var/lib/wangzhe-restore/work/uploads
RESTORE_DRILL_STATUS_FILE=/var/lib/wangzhe-restore/work/last-success.status
RESTORE_DRILL_STATUS_REMOTE_DESTINATION=CHANGE_ME_RCLONE_REMOTE:wangzhe-production/restore-status/last-success.status
# A different owner-only config and credential, restricted to writing/reading
# back the exact status, .sha256 and .sig objects above; no backup read access.
RESTORE_DRILL_STATUS_RCLONE_CONFIG=/etc/wangzhe/logical-restore-status-write-rclone.conf
# Independent Ed25519 PKCS#8 private key; owner wangzhe-restore, mode 0400.
RESTORE_DRILL_STATUS_SIGNING_KEY_FILE=/etc/wangzhe/logical-restore-status-ed25519-private.pem
