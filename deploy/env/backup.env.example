# Dedicated pg_dump credential only. Install as
# /etc/wangzhe/backup.env, owner wangzhe-backup, mode 0400.
BACKEND_DATABASE_HOST=127.0.0.1
BACKEND_DATABASE_PORT=5432
BACKEND_DATABASE_USER=wangzhe_backup
BACKEND_DATABASE_PASSWORD=CHANGE_ME_INDEPENDENT_BACKUP_PASSWORD
BACKEND_DATABASE_DBNAME=wangzhe
BACKEND_DATABASE_SSLMODE=disable
