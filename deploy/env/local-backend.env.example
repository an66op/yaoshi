# Copy this file to an ignored local path, chmod it to 600, and edit it.
# An empty password is allowed only when the local PostgreSQL authentication
# policy explicitly permits it.
BACKEND_SERVER_MODE=debug
BACKEND_SERVER_BIND=0.0.0.0
BACKEND_SERVER_PORT=8080
BACKEND_DATABASE_HOST=localhost
BACKEND_DATABASE_PORT=5432
BACKEND_DATABASE_USER=postgres
BACKEND_DATABASE_PASSWORD=123456
BACKEND_DATABASE_DBNAME=wangzhe
BACKEND_DATABASE_SSLMODE=disable
# 执行 dev-reset-business-data.sh 时必须改为本机实际的绝对上传目录。
# 普通本地启动未设置时，后端仍使用 backend/uploads。
# BACKEND_UPLOAD_DIR=/absolute/path/to/yaoshi/backend/uploads
