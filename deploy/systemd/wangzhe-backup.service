[Unit]
Description=Verified PostgreSQL backup for Wangzhe
After=postgresql.service network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/wangzhe-backup-work/database
OnFailure=wangzhe-ops-failure-alert@%n.service

[Service]
Type=oneshot
User=wangzhe-backup
Group=wangzhe-backup
Environment=APPLICATION_DATABASE_USER=wangzhe
ExecStart=/opt/wangzhe/current/scripts/postgres-backup.sh /etc/wangzhe/backup.env /etc/wangzhe/backup-crypto.env
TimeoutStartSec=6h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/wangzhe/backup.env /etc/wangzhe/backup-crypto.env /etc/wangzhe/backup-rclone.conf /etc/wangzhe/backup-provenance-ed25519-private.pem
ReadWritePaths=/var/backups/wangzhe/database /var/lib/wangzhe-backup-work/database
NoNewPrivileges=true
PrivateDevices=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
SystemCallArchitectures=native
