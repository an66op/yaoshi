[Unit]
Description=Wangzhe lottery application backend
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3
OnFailure=wangzhe-ops-failure-alert@%n.service

[Service]
Type=simple
User=wangzhe
Group=wangzhe
WorkingDirectory=/var/lib/wangzhe
EnvironmentFile=/etc/wangzhe/backend.env
ExecStartPre=/usr/bin/test -d /var/lib/wangzhe/uploads
ExecStart=/opt/wangzhe/current/bin/wangzhe-backend
Restart=on-failure
RestartSec=3
TimeoutStartSec=90
TimeoutStopSec=15
LimitNOFILE=65536
UMask=0027
StateDirectory=wangzhe
StateDirectoryMode=0750

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/wangzhe
PrivateDevices=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
