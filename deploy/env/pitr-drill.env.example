# Install only on a dedicated isolated recovery host. Owner postgres, mode 0400.
# /var/lib/wangzhe-pitr-drill must be a root-owned, direct LUKS dm-crypt mount
# with a pre-created postgres-owned 0700 work child. Never point these values at
# a production PostgreSQL data directory or port.
PITR_DRILL_ISOLATION_MARKER=/etc/wangzhe/recovery-host
PITR_DRILL_AGE_IDENTITY_FILE=/etc/wangzhe/pitr-recovery-age-identity.txt
PITR_DRILL_PROVENANCE_VERIFY_KEY_FILE=/etc/wangzhe/pitr-provenance-ed25519-public.pem
# Read from `pg_controldata`; the archive and base-backup directory suffix must
# be this exact identifier so artifacts from different clusters cannot mix.
PITR_DRILL_CLUSTER_ID=CHANGE_ME_POSTGRES_SYSTEM_IDENTIFIER
# The networked pre-sync unit atomically publishes one verified generation below
# this fixed root. The drill itself remains offline and never reads production
# backup mounts directly.
PITR_DRILL_SOURCE_ROOT=/var/lib/wangzhe-pitr-source
PITR_DRILL_SOURCE_REMOTE_DESTINATION=CHANGE_ME_RCLONE_REMOTE:wangzhe-production/pitr/CHANGE_ME_POSTGRES_SYSTEM_IDENTIFIER
PITR_DRILL_POSTGRES_BIN_DIR=/usr/lib/postgresql/16/bin
PITR_DRILL_DATABASE_NAME=wangzhe
PITR_DRILL_DATABASE_USER=postgres
PITR_DRILL_PORT=55432

# Recover to a point safely behind the newest expected archived WAL. A base
# backup is eligible only after it has also aged past the minimum below.
PITR_DRILL_RECOVERY_LAG_MINUTES=15
PITR_DRILL_MIN_BASE_AGE_MINUTES=60
PITR_DRILL_START_TIMEOUT_SECONDS=600
# Allows a long restore to keep reading the same locked generation while still
# rejecting stale sources when the drill script is invoked outside systemd.
PITR_DRILL_MAX_SOURCE_AGE_SECONDS=86400
# Independent Ed25519 PKCS#8 private key; owner postgres, mode 0400.
PITR_DRILL_STATUS_SIGNING_KEY_FILE=/etc/wangzhe/pitr-restore-status-ed25519-private.pem

# The offline drill only opens these files to prove the source read and status
# write credentials are distinct by canonical path, device/inode and SHA-256.
# PrivateNetwork prevents this validation process from using either credential.
PITR_DRILL_WAL_READ_RCLONE_CONFIG=/etc/wangzhe/pitr-wal-read-rclone.conf
PITR_DRILL_STATUS_WRITE_RCLONE_CONFIG=/etc/wangzhe/pitr-status-write-rclone.conf

# `wangzhe-pitr-source-sync.service` must succeed immediately before the supplied
# PrivateNetwork drill unit starts. The drill fails closed if the active
# generation, full encrypted-file hashes, exact remote provenance markers or WAL
# source manifests are missing or do not match this cluster.
